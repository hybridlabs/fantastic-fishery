{
	"schemaVersion": 1,
	"id": "fantastic_fishery",
	"version": "${version}",

	"name": "Fantastic Fishery",
	"description": "${description}",

	"authors": [
		"Hybrid Labs"
	],

	"contact": {
		"homepage": "https://hybridlabs.net/",
		"sources": "https://github.com/hybridlabs/fantastic-fishery",
		"issues": "https://github.com/hybridlabs/fantastic-fishery/issues"
	},

	"license": "ARR",
	"icon": "assets/fantastic_fishery/icon.png",

	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "dev.hybridlabs.fantasticfishery.FantasticFishery",
				"adapter": "kotlin"
			}
		],
        "client": [
          {
            "value": "dev.hybridlabs.fantasticfishery.FantasticFisheryClient",
            "adapter": "kotlin"
          }
      ],
		"fabric-datagen": [
			{
				"value": "dev.hybridlabs.fantasticfishery.data.FantasticFisheryDataGenerator",
				"adapter": "kotlin"
			}
		]
	},

  "mixins": [
    "fantastic_fishery.fabric.mixins.json"
  ],

	"depends": {
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-language-kotlin": "*",
		"fabric-api": ">=0.155",
        "geckolib": ">=5.5.2",
        "lithostitched": ">=1.8.1",
        "hapi": ">=1.2.0"
    }
}
